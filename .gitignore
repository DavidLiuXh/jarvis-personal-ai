# API keys and secrets
.env
.env~

# gemini-cli settings
# We want to keep the .gemini in the root of the repo and ignore any .gemini
# in subdirectories. In our root .gemini we want to allow for version control
# for subcommands.
**/.gemini/
!/.gemini/
.gemini/*
!.gemini/config.yaml
!.gemini/commands/
!.gemini/skills/
!.gemini/agents/
!.gemini/settings.json

# Note: .gemini-clipboard/ is NOT in gitignore so Gemini can access pasted images

# Dependency directory
node_modules
bower_components

# Editors
.idea
*.iml

# OS metadata
.DS_Store
Thumbs.db

# TypeScript build info files
*.tsbuildinfo

# Ignore built ts files
dist

# Docker folder to help skip auth refreshes
.docker

bundle

# Test report files
junit.xml
packages/*/coverage/

# Generated files
packages/cli/src/generated/
packages/core/src/generated/
packages/devtools/src/_client-assets.ts
.integration-tests/
packages/vscode-ide-companion/*.vsix
packages/cli/download-ripgrep*/

# GHA credentials
gha-creds-*.json

# Log files
patch_output.log
gemini-debug.log
*.log
jarvis.log

# Generated reports
market_report*.html

.genkit
.gemini-clipboard/
.eslintcache
evals/logs/

# Python cache and compiled files
__pycache__/
*.pyc

# Local database files
*.db
*.db-wal
*.db-shm
memory/
memory_/

# Local sessions and runtime configs containing potential secrets
wechat_session.json
wechat_session.json_
wechat_session.json.bak
config.json
tasks.json
tasks.json_
test_wechat.py
wechat_login.py

# Temp files and outputs
*_output.txt
massive-client-python-temp/
storage/
runtime/

