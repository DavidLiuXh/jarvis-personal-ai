From 2db1e3dfe0c6d77b5067358fa3b3a75771834bca Mon Sep 17 00:00:00 2001
From: liuwei <liuwei@MBP-D71QQDP2FR-2153.local>
Date: Fri, 8 May 2026 11:18:01 +0800
Subject: [PATCH 2/2] perf(core): skip systemInstruction for utility tool LLM
 calls

Utility tool calls (e.g. google_web_search grounding, compressor,
summarizer) do not need a persona or agent instructions. Sending the
full systemInstruction wastes tokens on every tool-internal LLM request.
Only MAIN and SUBAGENT roles receive systemInstruction; all UTILITY_*
roles get undefined, saving thousands of tokens per tool invocation.
---
 packages/core/src/core/client.ts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/packages/core/src/core/client.ts b/packages/core/src/core/client.ts
index 4e7efbf39..3ad4e09d0 100644
--- a/packages/core/src/core/client.ts
+++ b/packages/core/src/core/client.ts
@@ -52,7 +52,7 @@ import type {
   DefaultHookOutput,
   AfterAgentHookOutput,
 } from '../hooks/types.js';
-import { NextSpeakerCheckEvent, type LlmRole } from '../telemetry/types.js';
+import { NextSpeakerCheckEvent, LlmRole } from '../telemetry/types.js';
 import { uiTelemetryService } from '../telemetry/uiTelemetry.js';
 import type { IdeContext, File } from '../ide/types.js';
 import { handleFallback } from '../fallback/handler.js';
@@ -1044,7 +1044,12 @@ export class GeminiClient {
 
     try {
       const userMemory = this.config.getSystemInstructionMemory();
-      const systemInstruction = getCoreSystemPrompt(this.config, userMemory);
+      // Utility tool calls (e.g. google_web_search grounding) do not need a
+      // persona or skill instructions — skip systemInstruction to save tokens.
+      const systemInstruction =
+        role === LlmRole.MAIN || role === LlmRole.SUBAGENT
+          ? getCoreSystemPrompt(this.config, userMemory)
+          : undefined;
       const {
         model,
         config: newConfig,
