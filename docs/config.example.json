{
  "api": {
    "key": "",
    "proxy": "",
    "forceApiKey": false
  },
  "models": {
    "chat": "auto",
    "embedding": "models/gemini-embedding-001",
    "embeddingDimension": 1024,
    "distillation": "gemini-2.5-flash"
  },
  "llmBackend": {
    "provider": "deepseek",
    "openai": {
      "apiKeyEnv": "OPENAI_API_KEY",
      "model": "gpt-4.1",
      "baseUrl": "https://api.openai.com/v1",
      "timeoutMs": 120000
    },
    "deepseek": {
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "model": "deepseek-v4-pro",
      "baseUrl": "https://api.deepseek.com",
      "timeoutMs": 120000,
      "thinking": "disabled",
      "reasoningEffort": "high"
    }
  },
  "ollama": {
    "baseUrl": "http://localhost:11434",
    "defaultTimeoutMs": 120000
  },
  "embeddingService": {
    "provider": "ollama",
    "model": "bge-m3"
  },
  "reflection": {
    "provider": "ollama",
    "model": "gemma4:e2b",
    "timeoutMs": 120000
  },
  "entityExtraction": {
    "enabled": true,
    "provider": "ollama",
    "model": "gemma4:e2b",
    "timeoutMs": 120000
  },
  "routing": {
    "enabled": true,
    "provider": "ollama",
    "model": "gemma4:e2b",
    "threshold": 70,
    "targets": {
      "pro": "deepseek-v4-pro",
      "flash": "deepseek-v4-flash"
    }
  },
  "intentFeedback": {
    "enabled": false,
    "captureAll": false,
    "redact": true,
    "maxPromptChars": 800,
    "maxHistoryTurns": 6,
    "maxHistoryChars": 240
  },
  "summarizer": {
    "provider": "ollama",
    "model": "gemma4:e2b",
    "chunkSize": 100
  },
  "network": {
    "maxRetries": 3,
    "cleanOrphanedTurnOnFailure": true,
    "maxToolIterations": 30,
    "maxConsecutiveToolFailures": 3
  },
  "server": {
    "port": 3000
  },
  "ui": {
    "markdownDiagnostics": false,
    "markdownDiagnosticsMaxChars": 240,
    "markdownDiagnosticsChunkSampleRate": 0
  },
  "memory": {
    "ingestionDelayMs": 800,
    "retrievalLimit": 5,
    "consolidationThreshold": 3,
    "dedupStrategy": "embedding",
    "factRelevanceStrategy": "embedding",
    "factRelevanceLimit": 5,
    "prewarmLimit": 3,
    "ingestConversations": false,
    "eventsExtractionInterval": 20,
    "skipStartupEventsBackfill": false,
    "l1WriteMode": "batch",
    "vectorSimilarityWeight": 0.7,
    "importanceWeight": 0.2,
    "accessWeight": 0.1,
    "decayLambda": 0.1,
    "hybridSearch": true,
    "rrfK": 60,
    "factMaxDistance": 1.0
  },
  "security": {
    "jailbreak": false,
    "shell": {
      "allowNetworkFetchCommands": true,
      "networkFetchCommands": ["curl", "wget"]
    }
  },
  "feishu": {
    "enabled": false,
    "appId": "",
    "appSecret": "",
    "showThoughts": false
  },
  "wechat": {
    "enabled": false,
    "apiBaseUrl": "https://your-wechat-api-host"
  },
  "session": {
    "useGlobalSession": true,
    "globalSessionId": "jarvis-global",
    "resumeOnStart": true,
    "recentTurnsOnResume": 3,
    "historyCompressionThreshold": 30,
    "historyKeepRecentTurns": 5,
    "codeHeavyThresholdMultiplier": 2.0
  }
}
