{
  "name": "jarvis-personal-ai",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "jarvis"
  ],
  "private": "true",
  "optionalDependencies": {
    "@google/gemini-cli": "file:gemini-cli/packages/cli",
    "@google/gemini-cli-core": "file:gemini-cli/packages/core"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidLiuXh/jarvis-personal-ai.git"
  },
  "scripts": {
    "start": "npx tsx jarvis/src/index.ts",
    "intent:matrix:generate": "npx tsx scripts/generate_intent_semantic_matrix.ts",
    "intent:matrix": "npx tsx scripts/run_intent_matrix.ts",
    "intent:feedback:review": "npx tsx scripts/review_intent_feedback.ts",
    "intent:report": "npx tsx scripts/summarize_intent_evals.ts",
    "intent:attribute-failures": "npx tsx scripts/attribute_intent_failures.ts",
    "runtime:check-boundaries": "npx tsx scripts/check_runtime_boundaries.ts",
    "llm:backend:eval": "npx tsx scripts/run_llm_backend_evals.ts",
    "llm:backend:eval:standalone": "npx tsx scripts/run_llm_backend_evals.ts --suite standalone",
    "llm:backend:eval:compatibility": "npx tsx scripts/run_llm_backend_evals.ts --suite compatibility",
    "runtime:dashboard": "npx tsx scripts/runtime_quality_dashboard.ts",
    "runtime:build": "npm run build --workspace @jarvis/memory-runtime && npm run build --workspace @jarvis/intent-runtime && npm run build --workspace @jarvis/agent-runtime",
    "runtime:pack:dry-run": "npm run pack:dry-run --workspace @jarvis/memory-runtime && npm run pack:dry-run --workspace @jarvis/intent-runtime && npm run pack:dry-run --workspace @jarvis/agent-runtime",
    "runtime:check-examples": "npx tsx scripts/check_runtime_examples.ts",
    "memory:quality": "npx tsx scripts/run_memory_quality.ts",
    "task-graph:quality": "npx tsx scripts/run_task_graph_quality.ts",
    "runtime:quality": "npm run runtime:build && npm run runtime:check-examples && npm run memory:quality && npm run task-graph:quality && npm run intent:matrix && npm run llm:backend:eval && npm run runtime:check-boundaries && npx tsx scripts/runtime_quality_dashboard.ts --gate",
    "runtime:quality:standalone": "npm run runtime:build && npm run llm:backend:eval:standalone && npm run runtime:check-boundaries",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
