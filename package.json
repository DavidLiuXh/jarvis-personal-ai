{
  "name": "jarvis-personal-ai",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "workspaces": [
    "jarvis",
    "gemini-cli/packages/core",
    "gemini-cli/packages/cli"
  ],
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidLiuXh/jarvis-personal-ai.git"
  },
  "scripts": {
    "start": "npx tsx jarvis/src/index.ts",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
