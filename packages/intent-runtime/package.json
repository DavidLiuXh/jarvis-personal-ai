{
  "name": "@jarvis/intent-runtime",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dateRange": {
      "types": "./dist/dateRange.d.ts",
      "import": "./dist/dateRange.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./executionPlan": {
      "types": "./dist/executionPlan.d.ts",
      "import": "./dist/executionPlan.js"
    },
    "./intentResolver": {
      "types": "./dist/intentResolver.d.ts",
      "import": "./dist/intentResolver.js"
    },
    "./modelClient": {
      "types": "./dist/modelClient.d.ts",
      "import": "./dist/modelClient.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@jarvis/memory-runtime": "0.1.0"
  },
  "sideEffects": false
}
